// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  ADMIN
  MANAGEMENT
  SENIOR_MANAGER
  HR_RECRUITER
  EMPLOYEE
}

// NextAuth Required Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For Credentials login
  role          Role      @default(EMPLOYEE)
  
  accounts      Account[]
  sessions      Session[]
  
  // Link to Employee Data
  employeeProfile EmployeeProfile?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------
// Core HR Modules Data
// ------------------------------------------------------------------

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  
  employees   EmployeeProfile[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmployeeProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  employeeId     String   @unique // e.g., "EMP-001"
  contactNumber  String?
  address        String?
  
  designation    String?
  joiningDate    DateTime?
  salary         Float?
  employmentStatus String @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  
  // For hierarchical reporting
  managerId      String?
  manager        EmployeeProfile?  @relation("ManagerToEmployee", fields: [managerId], references: [id])
  directReports  EmployeeProfile[] @relation("ManagerToEmployee")

  // Features
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  payslips       Payslip[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ------------------------------------------------------------------
// Attendance, Leave, Payroll
// ------------------------------------------------------------------

model Attendance {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  
  date              DateTime        @db.Date
  clockIn           DateTime?
  clockOut          DateTime?
  status            String          @default("PRESENT") // PRESENT, ABSENT, HALF_DAY
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model LeaveRequest {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  
  type              String          // SICK, VACATION, PERSONAL
  startDate         DateTime        @db.Date
  endDate           DateTime        @db.Date
  reason            String?         @db.Text
  status            String          @default("PENDING") // PENDING, APPROVED, REJECTED
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Payslip {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  
  month             String          // "2026-10"
  basicSalary       Float
  allowances        Float           @default(0)
  deductions        Float           @default(0)
  netSalary         Float
  status            String          @default("PAID") // PAID, PENDING
  pdfUrl            String?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// ------------------------------------------------------------------
// AI Recruitment Pipeline Data (Primary Feature)
// ------------------------------------------------------------------

model JobPosting {
  id              String      @id @default(cuid())
  title           String
  description     String      @db.Text
  requiredSkills  Json        // Array of required skills
  isActive        Boolean     @default(true)
  
  candidates      Candidate[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum CandidateStatus {
  APPLIED
  SCREENED
  INTERVIEWED
  SELECTED
  HIRED
  REJECTED
}

model Candidate {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  phone           String?
  resumeUrl       String?          // URL to PDF in Supabase Storage
  status          CandidateStatus  @default(APPLIED)
  
  jobPostingId    String
  jobPosting      JobPosting       @relation(fields: [jobPostingId], references: [id])
  
  aiEvaluation    AIEvaluation?
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model AIEvaluation {
  id                  String     @id @default(cuid())
  candidateId         String     @unique
  candidate           Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  // Resume Parsing Scores
  matchScore          Float?     // Overall fit against JD (0-100)
  skillScore          Float?
  experienceScore     Float?
  extractedSkills     Json?      // Skills found in the resume
  
  // Interview Scores
  interviewTranscript String?    @db.Text
  communicationScore  Float?
  technicalScore      Float?
  confidenceScore     Float?
  
  finalRecommendation String?    // "Strongly Recommended", "Recommended", "Not Recommended"
  aiSummary           String?    @db.Text
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}
